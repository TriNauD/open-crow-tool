# 与网站 NEXT_PUBLIC_SUPABASE_* / 站点 origin 同值。复制为 chrome-extension/.env 后执行 npm run build。
# 用于：扩展内登录；划词保存前 refresh（storage 缺 supabase 字段时从构建产物补齐）。
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=
# Crow 站点 origin（无尾斜杠）；扩展内登录成功后的默认 apiBaseUrl
VITE_PUBLIC_SITE_ORIGIN=https://dev.crowknows.tech
